# API
VITE_API_URL=https://admin-api.example.com
VITE_WSS_URL=wss://realtime.example.com
VITE_DNS_URL=https://dns.example.com
VITE_DNS_API_KEY=your_dns_api_key_here

# Public REST API that generated API keys authenticate against (shown to
# users on the API Keys pages) - distinct from VITE_API_URL above, which is
# this admin panel's own internal backend.
VITE_PUBLIC_API_URL=https://public-api.mailservice25.com
# Public reference docs for that API
VITE_V3_API_DOCS_URL=https://docs.yukthi-mail.in/

# reCAPTCHA (Google reCAPTCHA v2 site key, domain-restricted in Google console)
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# App Info
VITE_BASE_ORG=YOUR_ORG
VITE_APP_NAME=Admin Panel
VITE_APP_VERSION=1.0.0
VITE_BUILD_DATE=01-01-2026
VITE_API_VERSION=1.0.0
VITE_ENVIRONMENT=Development
VITE_COPYRIGHT=© 2026 Your Company

# Observability (OpenObserve RUM/logs) - optional, leave blank to disable
# Enabled in Production only (VITE_ENVIRONMENT must be "Production"); ignored in test/dev
VITE_RUM_CLIENT_TOKEN=
VITE_RUM_SITE=
VITE_RUM_APPLICATION_ID=phoenix-admin-ui-id
VITE_RUM_SERVICE=phoenix-admin-ui-app
VITE_RUM_ORG_IDENTIFIER=default
